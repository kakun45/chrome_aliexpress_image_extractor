{
  "manifest_version": 3,
  "name": "AliExpress Image Extractor",
  "version": "1.0",
  "description": "Extract listing images and save them in a ZIP.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.alicdn.com/*",
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://*.aliexpress-media.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract listing images"
  }
}